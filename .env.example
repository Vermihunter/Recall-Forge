# Neon / Vercel Marketplace PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Used only by `npm run export:mongo-user-data` against your OLD Recall Forge database.
MIGRATION_MONGODB_URI=mongodb://localhost:27017/recall_forge

# Optional but recommended for a single-user public deployment.
# When set, Recall Forge uses HTTPS Basic Auth at the edge.
APP_USERNAME=recall
APP_PASSWORD=change-this-long-random-password
